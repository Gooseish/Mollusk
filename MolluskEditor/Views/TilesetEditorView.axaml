<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:MolluskEditor.ViewModels"
             x:DataType="vm:TilesetEditorViewModel"
             x:Class="MolluskEditor.Views.TilesetEditorView">
  <StackPanel Orientation="Horizontal">
    <ContentControl Content = "{Binding Data}"/>
    <Grid ColumnDefinitions="*, *" RowDefinitions="*, *" Margin="5">
      <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
          <Label>Id</Label>
          <TextBox Text="{Binding SelectedTileset.Id}"></TextBox>
          <Label>Name</Label>
          <TextBox Text="{Binding SelectedTileset.Name}"></TextBox>
        </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
